# Copiar a .env solamente si todavia no existe.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_NAME=merceria
PORT=3000
# true solo para crear/sincronizar una base local de desarrollo.
DB_SYNCHRONIZE=false

# Local development. Use NODE_ENV=production on the server.
NODE_ENV=development
HOST=127.0.0.1
BUSINESS_TIMEZONE=America/Lima
# Comma-separated exact frontend origins; blank means no cross-origin access.
CORS_ORIGINS=
# Only set 1 behind a trusted single proxy; compose uses Caddy with no direct API port.
TRUST_PROXY=0
# Disabled by default in production.
ENABLE_SWAGGER=false
# For Docker/Caddy deployment only: hostname without https://
DOMAIN=
